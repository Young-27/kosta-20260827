{
  "enabledPlugins": {
    "github@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/trace.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/gate-write.sh"
          }
        ]
      }
    ]
  }
}
